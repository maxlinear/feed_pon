diff --git a/linux/drivers/net/dsa/mxl862xx/mxl862xx.c b/linux/drivers/net/dsa/mxl862xx/mxl862xx.c
index 5c3d9ac..808e99a 100644
--- a/linux/drivers/net/dsa/mxl862xx/mxl862xx.c
+++ b/linux/drivers/net/dsa/mxl862xx/mxl862xx.c
@@ -2028,7 +2028,7 @@ __prepare_vlan_egress_filters_off_sp_tag_no_vid(struct dsa_switch *ds, uint8_t p
 
 	// Static entry :  Outer and iner tag.
 	// Remove outer tag  one as it must be sp_tag. Transparent for inner tag.
-	memset(&vlan_cfg, 0, sizeof(vlan_cfg));
+	memset((void *)&vlan_cfg, 0, sizeof(vlan_cfg));
 	vlan_cfg.extended_vlan_block_id =
 		priv->port_info[port].vlan.egress_vlan_block_info.block_id;
 	vlan_cfg.entry_index = priv->port_info[port].vlan.egress_vlan_block_info.filters_max - 2;
@@ -2051,7 +2051,7 @@ __prepare_vlan_egress_filters_off_sp_tag_no_vid(struct dsa_switch *ds, uint8_t p
 	__print_vlan_filter(priv, __func__, port, &vlan_cfg);
 
 	// Last entry :  Only outer tag. Remove it as it must be sp_tag
-	memset(&vlan_cfg, 0, sizeof(vlan_cfg));
+	memset((void *)&vlan_cfg, 0, sizeof(vlan_cfg));
 	vlan_cfg.extended_vlan_block_id =
 		priv->port_info[port].vlan.egress_vlan_block_info.block_id;
 	vlan_cfg.entry_index = priv->port_info[port].vlan.egress_vlan_block_info.filters_max - 1;
@@ -2115,7 +2115,7 @@ __prepare_vlan_egress_filters_off_sp_tag(struct dsa_switch *ds, uint8_t port, ui
 		goto EXIT;
 
 	// Entry 0 :  Outer and Inner tags are present. Inner tag matching vid.
-	memset(&vlan_cfg, 0, sizeof(vlan_cfg));
+	memset((void *)&vlan_cfg, 0, sizeof(vlan_cfg));
 	vlan_cfg.extended_vlan_block_id =
 		priv->port_info[port].vlan.egress_vlan_block_info.block_id;
 	/* if found recycled entry reuse it, otherwise create new one */
@@ -2158,7 +2158,7 @@ __prepare_vlan_egress_filters_off_sp_tag(struct dsa_switch *ds, uint8_t port, ui
 		.filters_idx[1] = IDX_INVAL;
 
 	// Static entry :  Outer and iner tag, not matching vid. Remove outer tag  one as it must be sp_tag
-	memset(&vlan_cfg, 0, sizeof(vlan_cfg));
+	memset((void *)&vlan_cfg, 0, sizeof(vlan_cfg));
 	vlan_cfg.extended_vlan_block_id =
 		priv->port_info[port].vlan.egress_vlan_block_info.block_id;
 	vlan_cfg.entry_index = priv->port_info[port].vlan.egress_vlan_block_info.filters_max - 2;
@@ -2181,7 +2181,7 @@ __prepare_vlan_egress_filters_off_sp_tag(struct dsa_switch *ds, uint8_t port, ui
 	__print_vlan_filter(priv, __func__, port, &vlan_cfg);
 
 	// Last entry :  Only outer tag. Remove it as it must be sp_tag
-	memset(&vlan_cfg, 0, sizeof(vlan_cfg));
+	memset((void *)&vlan_cfg, 0, sizeof(vlan_cfg));
 	vlan_cfg.extended_vlan_block_id =
 		priv->port_info[port].vlan.egress_vlan_block_info.block_id;
 	vlan_cfg.entry_index = priv->port_info[port].vlan.egress_vlan_block_info.filters_max - 1;
@@ -2247,7 +2247,7 @@ __prepare_vlan_egress_filters_off(struct mxl862xx_priv *priv, uint8_t port, uint
 		goto EXIT;
 
 	// Entry 0 : ACCEPT VLAN tags that are matching  VID. Outer and Inner tags are present
-	memset(&vlan_cfg, 0, sizeof(vlan_cfg));
+	memset((void *)&vlan_cfg, 0, sizeof(vlan_cfg));
 	vlan_cfg.extended_vlan_block_id =
 		priv->port_info[port].vlan.egress_vlan_block_info.block_id;
 	/* if found recycled entry reuse it, otherwise create new one */
@@ -2279,7 +2279,7 @@ __prepare_vlan_egress_filters_off(struct mxl862xx_priv *priv, uint8_t port, uint
 		.filters_idx[0] = vlan_cfg.entry_index;
 
 	//	 Entry 1 : ACCEPT VLAN tags that are matching PVID or port VID. Only the outer tags are present
-	memset(&vlan_cfg, 0, sizeof(vlan_cfg));
+	memset((void *)&vlan_cfg, 0, sizeof(vlan_cfg));
 	vlan_cfg.extended_vlan_block_id =
 		priv->port_info[port].vlan.egress_vlan_block_info.block_id;
 	/* if found recycled entry reuse it, otherwise create new one */
@@ -2342,7 +2342,7 @@ __prepare_vlan_ingress_filters_off_sp_tag_no_vid(struct dsa_switch *ds, uint8_t
 		block_info->block_id = vlan_alloc.extended_vlan_block_id;
 	}
 
