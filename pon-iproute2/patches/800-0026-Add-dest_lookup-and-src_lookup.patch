From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hauke Mehrtens <hmehrtens@maxlinear.com>
Date: Fri, 18 Feb 2022 10:02:01 +0100
Subject: Add dest_lookup and src_lookup

This allows to read and set the multicast destination and source lookup
settings on a bridge port in the kernel. This is used for PON.

Set it like this:
  $ bridge link set dev eth0_0 src_lookup on
  $ bridge link set dev eth0_0 dest_lookup off

look at the setting like this:
  $ bridge -d link show dev eth0_0
  5: eth0_0: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 9582 master sw257 state forwarding priority 32 cost 2 learning_limit -1
      hairpin off guard off root_block off fastleave off learning on flood on mcast_flood on isolated off dest_lookup off src_lookup on eth0_0
---
 bridge/link.c                | 26 ++++++++++++++++++++++++++
 include/uapi/linux/if_link.h |  2 ++
 2 files changed, 28 insertions(+)

diff --git a/bridge/link.c b/bridge/link.c
index a967c3b1..f9f5624a 100644
--- a/bridge/link.c
+++ b/bridge/link.c
@@ -204,6 +204,13 @@ static void print_protinfo(FILE *fp, struct rtattr *attr)
 			print_uint(PRINT_ANY, "mcast_max_groups",
 				   "mcast_max_groups %u ", rta_getattr_u32(at));
 		}
+		if (prtb[IFLA_BRPORT_DEST_LOOKUP])
+			print_on_off(PRINT_ANY, "dest_lookup", "dest_lookup %s ",
+				    rta_getattr_u8(prtb[IFLA_BRPORT_DEST_LOOKUP]));
+
+		if (prtb[IFLA_BRPORT_SRC_LOOKUP])
+			print_on_off(PRINT_ANY, "src_lookup", "src_lookup %s ",
+				    rta_getattr_u8(prtb[IFLA_BRPORT_SRC_LOOKUP]));
 	} else
 		print_stp_state(rta_getattr_u8(attr));
 }
@@ -306,6 +313,8 @@ static void usage(void)
 		"                               [ isolated {on | off} ]\n"
 		"                               [ locked {on | off} ]\n"
 		"                               [ mab {on | off} ]\n"
+		"                               [ dest_lookup {on | off} ]\n"
+		"                               [ src_lookup {on | off} ]\n"
 		"                               [ hwmode {vepa | veb} ]\n"
 		"                               [ backup_port DEVICE ] [ nobackup_port ]\n"
 		"                               [ self ] [ master ]\n"
@@ -340,6 +349,8 @@ static int brlink_modify(int argc, char **argv)
 	__s8 locked = -1;
 	__s8 macauth = -1;
 	__s8 isolated = -1;
+	__s8 dest_lookup = -1;
+	__s8 src_lookup = -1;
 	__s8 hairpin = -1;
 	__s8 bpdu_guard = -1;
 	__s8 fast_leave = -1;
@@ -477,6 +488,17 @@ static int brlink_modify(int argc, char **argv)
 			macauth = parse_on_off("mab", *argv, &ret);
 			if (ret)
 				return ret;
+		} else if (strcmp(*argv, "dest_lookup") == 0) {
+			NEXT_ARG();
+			dest_lookup = parse_on_off("dest_lookup", *argv, &ret);
+			if (ret)
+				return ret;
+
+		} else if (strcmp(*argv, "src_lookup") == 0) {
+			NEXT_ARG();
+			src_lookup = parse_on_off("src_lookup", *argv, &ret);
+			if (ret)
+				return ret;
 		} else if (strcmp(*argv, "backup_port") == 0) {
 			NEXT_ARG();
 			backup_port_idx = ll_name_to_index(*argv);
@@ -573,6 +595,10 @@ static int brlink_modify(int argc, char **argv)
 	if (backup_port_idx != -1)
 		addattr32(&req.n, sizeof(req), IFLA_BRPORT_BACKUP_PORT,
 			  backup_port_idx);
+	if (dest_lookup != -1)
+		addattr8(&req.n, sizeof(req), IFLA_BRPORT_DEST_LOOKUP, dest_lookup);
+	if (src_lookup != -1)
+		addattr8(&req.n, sizeof(req), IFLA_BRPORT_SRC_LOOKUP, src_lookup);
 
 	addattr_nest_end(&req.n, nest);
 
diff --git a/include/uapi/linux/if_link.h b/include/uapi/linux/if_link.h
index 6aeb9732..6fd99cbf 100644
--- a/include/uapi/linux/if_link.h
+++ b/include/uapi/linux/if_link.h
@@ -568,6 +568,8 @@ enum {
 	IFLA_BRPORT_MCAST_N_GROUPS,
 	IFLA_BRPORT_MCAST_MAX_GROUPS,
 	IFLA_BRPORT_LEARNING_LIMIT,
+	IFLA_BRPORT_DEST_LOOKUP,
+	IFLA_BRPORT_SRC_LOOKUP,
 	__IFLA_BRPORT_MAX
 };
 #define IFLA_BRPORT_MAX (__IFLA_BRPORT_MAX - 1)
