#!/bin/sh

if [ ! -f /etc/config/todd ]; then
	touch /etc/config/todd
fi

uci set todd.daemon=todd
# "PONIP TOD 2" must be used by todd
dev=$(grep -l "PONIP TOD 2" /sys/class/ptp/ptp*/clock_name)
dev=${dev#/sys/class/ptp/} # remove prefix
dev=${dev%/clock_name} # remove suffix
uci set todd.daemon.ptp_device="/dev/$dev"
uci set todd.daemon.uart="/dev/ttyLTQ1"
uci set todd.daemon.uart_baudrate="115200"
uci set todd.daemon.output_mode="GPZDA"
